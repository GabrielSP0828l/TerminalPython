# Ambiente explicito: development abre janela normal; production abre fullscreen.
APP_ENV=development

# Endpoints versionaveis apenas como exemplos locais.
API_URL=https://tayna-fitful-mariko.ngrok-free.dev
WS_URL=ws://tayna-fitful-mariko.ngrok-free.dev

# Credenciais devem existir somente no runtime local e nunca no Git.
TERMINAL_ADMIN_PASSWORD=troque-por-uma-senha-forte
# Credencial individual e instalada em arquivo local 0600, fora do Git.
DEVICE_CREDENTIAL_PATH=/var/lib/app247-terminal/device-credential

# Migracao temporaria e explicita. Manter false na operacao normal.
LEGACY_TERMINAL_AUTH_ENABLED=false
TERMINAL_INTERNAL_TOKEN=

PRODUCT_SYNC_INTERVAL_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_RETRY_SECONDS=5
HEARTBEAT_ACK_TIMEOUT_SECONDS=5
TELEMETRY_INTERVAL_SECONDS=60
TELEMETRY_TIMEOUT_SECONDS=5
PAYMENT_CONNECT_TIMEOUT_SECONDS=5
PAYMENT_READ_TIMEOUT_SECONDS=20
RECEIPT_CONNECT_TIMEOUT_SECONDS=5
RECEIPT_READ_TIMEOUT_SECONDS=45
APP_VERSION=1.0.0
