# Configuração instalada em /etc/app247/terminal.env.
APP247_ENV=production

# Preencha antes de executar install.sh --activate.
APP247_API_URL=
APP247_WS_URL=

APP247_DATA_DIR=/var/lib/app247
APP247_DB_PATH=/var/lib/app247/terminal.db
APP247_TERMINAL_CONFIG_PATH=/var/lib/app247/terminal.json
APP247_DEVICE_CREDENTIAL_PATH=/var/lib/app247/device-credential
APP247_UPDATE_PUBLIC_KEY_PATH=/etc/app247/update-signing-public-key.pem
APP247_DISPLAY_ORIENTATION_PATH=/var/lib/app247/display_orientation
APP247_LAST_SYNC_PATH=/var/lib/app247/last_sync.txt

APP247_TERMINAL_ADMIN_PASSWORD=
APP247_TERMINAL_INTERNAL_TOKEN=
APP247_LEGACY_TERMINAL_AUTH_ENABLED=false

APP247_PRODUCT_SYNC_INTERVAL_SECONDS=300
APP247_HEARTBEAT_INTERVAL_SECONDS=10
APP247_HEARTBEAT_RETRY_SECONDS=5
APP247_HEARTBEAT_ACK_TIMEOUT_SECONDS=5
APP247_TELEMETRY_INTERVAL_SECONDS=60
APP247_TELEMETRY_TIMEOUT_SECONDS=5
APP247_PAYMENT_CONNECT_TIMEOUT_SECONDS=5
APP247_PAYMENT_READ_TIMEOUT_SECONDS=20
APP247_RECEIPT_CONNECT_TIMEOUT_SECONDS=5
APP247_RECEIPT_READ_TIMEOUT_SECONDS=45
